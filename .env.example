# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA versione o .env.local (já está no .gitignore).

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mydb
DATABASE_USER=
DATABASE_PASSWORD=
# true para exigir SSL (produção / banco remoto)
DATABASE_SSL=false
# Máximo de conexões no pool
DATABASE_POOL_MAX=10
